# Server
PORT=3001
NODE_ENV=development

# Python AI Service
AI_SERVICE_URL=http://localhost:8000

# Groq API (LLM) - Get free key at console.groq.com
GROQ_API_KEY=gsk_your-key-here
LLM_MODEL=llama-3.3-70b-versatile

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8100

# Upload limits
MAX_FILE_SIZE_MB=50
